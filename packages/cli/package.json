{
  "name": "@fabster/cli",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "fabster": "./dist/bin/fabster.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
